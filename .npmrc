# Publishing this package targets the public npm registry, not a mirror: package
# mirrors (e.g. registry.npmmirror.com) accept reads but reject publishes.
# This file is scoped to the repository, so a mirror set in ~/.npmrc still serves
# everyday installs at full speed.
registry=https://registry.npmjs.org/

# npm does not read the Windows system proxy, and this network reaches npmjs only
# through a local proxy. Without these lines `npm login`/`npm publish` time out.
# Adjust the port if your proxy listens elsewhere, or delete both lines on a
# network with direct access.
proxy=http://127.0.0.1:7897
https-proxy=http://127.0.0.1:7897

# Keep the published tarball reproducible.
save-exact=true
